{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Jobs submitted",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_jobs_submitted_total", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Healthy nodes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_nodes_current{health=\"healthy\"}", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}
    },
    {
      "type": "stat",
      "title": "Running jobs",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_jobs_current{status=\"running\"}", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "Pending jobs",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_jobs_current{status=\"pending\"}", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Lease expirations",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_assignment_lease_expirations_total", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}
    },
    {
      "type": "stat",
      "title": "Log bytes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(mini_modal_log_bytes_received_total)", "refId": "A"}],
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Jobs by status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_jobs_current", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "type": "timeseries",
      "title": "Control plane vs agent throughput",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "irate(mini_modal_jobs_submitted_total[10s])", "legendFormat": "control plane: accepted jobs/s", "refId": "A"},
        {"expr": "sum(irate(mini_modal_job_attempts_started_total[10s]))", "legendFormat": "agents: claimed attempts/s", "refId": "B"},
        {"expr": "sum(irate(mini_modal_job_attempts_finished_total[10s]))", "legendFormat": "agents: finished attempts/s", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "type": "timeseries",
      "title": "Queue wait p50 / p95 / p99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(mini_modal_job_queue_wait_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(mini_modal_job_queue_wait_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(mini_modal_job_queue_wait_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "type": "timeseries",
      "title": "Free node resources",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "mini_modal_node_resources_free", "legendFormat": "{{resource}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    },
    {
      "type": "timeseries",
      "title": "Scheduler p95 latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(mini_modal_scheduler_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
    },
    {
      "type": "timeseries",
      "title": "Retries scheduled / second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (reason) (rate(mini_modal_job_retries_scheduled_total[1m]))", "legendFormat": "{{reason}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["mini-modal"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "Mini Modal Overview",
  "uid": "mini-modal-overview",
  "version": 1
}
